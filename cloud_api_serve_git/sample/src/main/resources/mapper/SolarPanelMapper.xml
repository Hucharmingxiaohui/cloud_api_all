<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.dji.sample.df.solar.dao.SolarPanelMapper">

    <select id="selectListByMap" resultType="com.dji.sample.df.solar.model.entity.SolarPanel">
        SELECT * FROM manage_solar_panel
        <where>
            <if test="solarPanelName!=null and solarPanelName!=''">
                and solar_panel_name LIKE concat('%', #{solarPanelName},'%')
            </if>
        </where>
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
        </where>
        <where>
            <if test="orthophotoId!=null and orthophotoId!=''">
                and orthophoto_id = #{orthophotoId}
            </if>
        </where>
        <if test="pageSize != null and pageSize != '' ">
            LIMIT ${startPos}, ${pageSize}
        </if>
    </select>


    <select id="selectListCount" resultType="int">
        SELECT count(*) FROM manage_solar_panel
        <where>
            <if test="solarPanelName!=null and solarPanelName!=''">
                and solar_panel_name LIKE concat('%', #{solarPanelName},'%')
            </if>
        </where>
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
        </where>
        <where>
            <if test="orthophotoId!=null and orthophotoId!=''">
                and orthophoto_id = #{orthophotoId}
            </if>
        </where>
        <if test="pageSize != null and pageSize != '' ">
            LIMIT ${startPos}, ${pageSize}
        </if>
    </select>
</mapper>
