<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.dji.sample.df.solarDf.dao.SolarPanelMapper">

    <select id="selectListByMap" resultType="com.dji.sample.df.solarDf.model.entity.SolarPanel">
        SELECT * FROM manage_solar_panel
        <where>
            <if test="solarPanelName != null and solarPanelName != ''">
                AND solar_panel_name LIKE concat('%', #{solarPanelName}, '%')
            </if>
            <if test="id != null and id != ''">
                AND id = #{id}
            </if>
            <if test="orthophotoId != null and orthophotoId != ''">
                AND orthophoto_id = #{orthophotoId}
            </if>
        </where>
        <if test="pageSize != null and pageSize != '' and startPos != null">
            LIMIT ${startPos}, ${pageSize}
        </if>
    </select>


    <select id="selectListCount" resultType="int">
        SELECT count(*) FROM manage_solar_panel
        <where>
            <if test="solarPanelName != null and solarPanelName != ''">
                AND solar_panel_name LIKE concat('%', #{solarPanelName}, '%')
            </if>
            <if test="id != null and id != ''">
                AND id = #{id}
            </if>
            <if test="orthophotoId != null and orthophotoId != ''">
                AND orthophoto_id = #{orthophotoId}
            </if>
        </where>
    </select>
</mapper>
