<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.dji.sample.df.solarDf.dao.SolarStationPointsMapper">

    <select id="selectListById" resultType="com.dji.sample.df.solarDf.model.entity.SolarStationPoints">
        SELECT * FROM solar_station_points
        <where>
            <if test="id != null and id != ''">
                AND area_id = #{id}
            </if>
        </where>
        ORDER BY main_device_name, component_name, point_name
        <if test="pageSize != null and pageSize != '' and startPos != null">
            LIMIT ${startPos}, ${pageSize}
        </if>
    </select>

    <select id="selectListCount" resultType="int">
        SELECT COUNT(*) FROM solar_station_points
        <where>
            <if test="id != null and id != ''">
                AND area_id = #{id}
            </if>
        </where>
    </select>
</mapper>
