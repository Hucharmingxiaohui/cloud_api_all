<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.dji.sample.df.solar.dao.InspectionDeviceMapper">

    <select id="selectListByMap" resultType="com.dji.sample.df.solar.model.entity.InspectionDevice">
        SELECT * FROM manage_inspection_device
        <where>
            <if test="deviceName!=null and deviceName!=''">
                and device_name LIKE concat('%', #{deviceName},'%')
            </if>
        </where>
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
        </where>
        <if test="pageSize != null and pageSize != '' ">
            LIMIT ${startPos}, ${pageSize}
        </if>
    </select>


    <select id="selectListCount" resultType="int">
        SELECT COUNT(*) FROM manage_inspection_device
        <where>
            <if test="deviceName!=null and deviceName!=''">
                and device_name LIKE concat('%', #{deviceName},'%')
            </if>
        </where>
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
        </where>
    </select>
</mapper>
