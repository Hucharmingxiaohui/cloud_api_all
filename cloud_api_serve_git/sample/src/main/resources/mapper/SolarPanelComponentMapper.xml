<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.dji.sample.df.solarDf.dao.SolarPanelComponentMapper">

    <select id="selectListBySolarPanelId" resultType="com.dji.sample.df.solarDf.model.entity.SolarPanelComponent">
        SELECT * FROM manage_solar_panel_component
        WHERE solar_panel_id = #{solarPanelId}
    </select>

    <select id="selectListByComponentId" resultType="com.dji.sample.df.solarDf.model.entity.SolarPanelComponent">
        SELECT * FROM manage_solar_panel_component
        WHERE id = #{componentId}
    </select>


    <select id="selectCountByOrthophotoId" resultType="int">
        SELECT count(*) FROM manage_solar_panel_component
        WHERE orthophoto_id = #{orthophotoId}
    </select>

    <select id="selectListByOrthophotoId" resultType="com.dji.sample.df.solarDf.model.entity.SolarPanelComponent">
        SELECT * FROM manage_solar_panel_component
        WHERE orthophoto_id = #{orthophotoId}
    </select>

</mapper>
