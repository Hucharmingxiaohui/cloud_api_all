<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.dji.sample.df.solar.dao.OrthophotoEntityMapper">

    <select id="selectList" resultType="com.dji.sample.df.solar.model.entity.OrthophotoEntity">
        SELECT * FROM manage_orthophoto
        <where>
            <if test="name!=null and name!=''">
                and name LIKE concat('%', #{name},'%')
            </if>
        </where>
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
        </where>
        <if test="pageSize != null and pageSize != '' ">
            LIMIT ${startPos}, ${pageSize}
        </if>
    </select>


    <select id="selectListCount" resultType="int">
        SELECT count(*) FROM manage_orthophoto
        <where>
            <if test="name!=null and name!=''">
                and name LIKE concat('%', #{name},'%')
            </if>
        </where>
        <where>
            <if test="id!=null and id!=''">
                and id = #{id}
            </if>
        </where>
    </select>

</mapper>
