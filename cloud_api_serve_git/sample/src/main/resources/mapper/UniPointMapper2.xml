<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >

<mapper namespace="com.dji.sample.center.dao.UniPointMapper2">

    <select id="selectList" resultType="com.dji.sample.center.entity.UniPoint">
        SELECT * FROM df_uni_point
        <where>
            <if test="pointName!=null and pointName!=''">
                and point_name LIKE concat('%', #{pointName},'%')
            </if>
            <if test="componentName!=null and componentName!=''">
                and component_name LIKE concat('%', #{componentName},'%')
            </if>
            <if test="deviceName!=null and deviceName!=''">
                and device_name LIKE concat('%', #{deviceName},'%')
            </if>
            <if test="bayName!=null and bayName!=''">
                and bay_name LIKE concat('%', #{bayName},'%')
            </if>
            <if test="areaName!=null and areaName!=''">
                and area_name LIKE concat('%', #{areaName},'%')
            </if>
            <if test="waylineId!=null and waylineId!=''">
                and wayline_id = #{waylineId}
            </if>
        </where>
        <if test="pageSize != null and pageSize != '' ">
            LIMIT ${startPos}, ${pageSize}
        </if>
    </select>


    <select id="selectListCount" resultType="int">
        SELECT COUNT(*) FROM df_uni_point
        <where>
            <if test="pointName!=null and pointName!=''">
                and point_name LIKE concat('%', #{pointName},'%')
            </if>
            <if test="componentName!=null and componentName!=''">
                and component_name LIKE concat('%', #{componentName},'%')
            </if>
            <if test="deviceName!=null and deviceName!=''">
                and device_name LIKE concat('%', #{deviceName},'%')
            </if>
            <if test="bayName!=null and bayName!=''">
                and bay_name LIKE concat('%', #{bayName},'%')
            </if>
            <if test="areaName!=null and areaName!=''">
                and area_name LIKE concat('%', #{areaName},'%')
            </if>
            <if test="waylineId!=null and waylineId!=''">
                and wayline_id = #{waylineId}
            </if>
        </where>
    </select>
</mapper>
